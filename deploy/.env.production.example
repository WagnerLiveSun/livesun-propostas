# Copiar para .env NA RAIZ DO SERVIDOR; não enviar o .env local.
FLASK_ENV=production
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DB_ENGINE=mysql
# Preencher exatamente com os dados fornecidos pela hospedagem.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

PUBLIC_BASE_URL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=suporte@livesun.com.br
BREVO_SENDER_NAME=LiveSun - Propostas

# Caminho do Chrome/Chromium instalado no VPS, executado sem root.
PDF_BROWSER_PATH=

# Somente para a configuração Nginx deste pacote (um proxy confiável).
TRUST_PROXY=true
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
UPLOAD_FOLDER=/opt/livesun-propostas/uploads