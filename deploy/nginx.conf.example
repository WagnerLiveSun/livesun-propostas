# Substituir propostas.SEUDOMINIO.com.br pelo domínio real.
# Configuração HTTP inicial; habilitar certificado/HTTPS ANTES de utilizar o login.
server {
    listen 80;
    server_name propostas.SEUDOMINIO.com.br;
    client_max_body_size 16m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }

    # Não há root/alias para o diretório do projeto: .env, chaves e uploads
    # não devem ser publicados como arquivos estáticos.
}