# Ambiente
FLASK_ENV=development
SECRET_KEY=altere-esta-chave-em-producao

# Banco de Dados
DB_ENGINE=mysql  # ou postgresql

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=propostas
MYSQL_USER=root
MYSQL_PASSWORD=sua_senha_mysql

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=livesun_propostas
POSTGRES_USER=livesun_propostas
POSTGRES_PASSWORD=sua_senha_postgres

# Brevo: credenciais exclusivas do LiveSun - Propostas
BREVO_API_KEY=sua_chave_brevo
BREVO_RESET_PASSWORD_TEMPLATE_ID=1
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LiveSun - Propostas
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Sessão
SESSION_TIMEOUT=3600

# Opcional: caminho completo do Chrome/Edge para gerar PDFs do mesmo HTML da impressão
PDF_BROWSER_PATH=

# Cadastro público: manter fechado até migrations e revisão explícita dos dados.
PUBLIC_REGISTRATION_ENABLED=false
# Intervalo mínimo para reenvio manual de solicitação ao Central.
CENTRAL_REGISTRATION_RETRY_SECONDS=120
CENTRAL_CHECKOUT_URL=
PUBLIC_REGISTRATION_PREVIEW=false
PUBLIC_REGISTRATION_DATA_REVIEWED=false
EMAIL_CONFIRMATION_TTL_MINUTES=60
CONFIRMATION_RESEND_COOLDOWN_SECONDS=120
PUBLIC_REGISTRATION_RATE_LIMIT=5 per hour
REGISTRATION_IDENTITY_RATE_LIMIT=3 per hour
CONFIRMATION_RESEND_RATE_LIMIT=5 per hour
# Memória somente em processo/instância única; configure backend compartilhado ao escalar.
RATELIMIT_STORAGE_URI=memory://
TERMS_URL=
PRIVACY_URL=
TERMS_VERSION=
PRIVACY_VERSION=
# REGISTRATION_UNIQUENESS_APPROVED=true somente na execução autorizada da migration B.
