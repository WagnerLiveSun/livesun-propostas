# Ambiente
FLASK_ENV=development
SECRET_KEY=altere-esta-chave-em-producao

# Banco de Dados
DB_ENGINE=mysql  # ou postgresql

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=propostas
MYSQL_USER=root
MYSQL_PASSWORD=sua_senha_mysql

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=livesun_propostas
POSTGRES_USER=livesun_propostas
POSTGRES_PASSWORD=sua_senha_postgres

# Brevo: credenciais exclusivas do LiveSun - Propostas
BREVO_API_KEY=sua_chave_brevo
BREVO_RESET_PASSWORD_TEMPLATE_ID=1
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LiveSun - Propostas
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Sessão
SESSION_TIMEOUT=3600

# Opcional: caminho completo do Chrome/Edge para gerar PDFs do mesmo HTML da impressão
PDF_BROWSER_PATH=
